---
import { SITE_NAME } from '../consts';

const { pathname } = Astro.url;

const links = [
  { label: 'Home', href: '/', current: pathname === '/' },
  { label: 'Writing', href: '/#writing', current: pathname.startsWith('/blog/') },
  { label: 'Reading Notes', href: '/reading', current: pathname.startsWith('/reading') },
  { label: 'About', href: '/about', current: pathname.startsWith('/about') },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{SITE_NAME}</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.25rem;
  }

  .brand {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
</style>
